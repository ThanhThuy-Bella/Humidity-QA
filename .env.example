# ---- Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # CHỈ dùng phía server, không bao giờ public

# ---- URL của app (dùng trong QR code và email)
NEXT_PUBLIC_APP_URL=https://kiem-am-thv.vercel.app

# ---- Bảo mật cron + webhook (chuỗi ngẫu nhiên dài)
CRON_SECRET=chuoi-ngau-nhien-dai-32-ky-tu
IMPORT_WEBHOOK_SECRET=chuoi-ngau-nhien-khac

# ---- Email Daily Plan: chọn 1 trong 2 cách
# Cách A – SMTP (Office 365 cần bật "Authenticated SMTP" cho hộp thư gửi)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=humidity-bot@yourdomain.com
SMTP_PASS=app-password
MAIL_FROM="Humidity System THV <humidity-bot@yourdomain.com>"
# Cách B – Resend (https://resend.com, miễn phí 3.000 mail/tháng, cần xác minh domain)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# MAIL_FROM="Humidity System THV <kiem-am@yourdomain.com>"
